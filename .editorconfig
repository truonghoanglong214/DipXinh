root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,gradle}]
indent_size = 4

[*.{json,yml,yaml,xml,properties}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{sh}]
end_of_line = lf
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,webp,ico,pdf,jar,war,zip}]
charset = unset
insert_final_newline = false
trim_trailing_whitespace = false